# Copy this file to .env and update the values below

# Base URL of the backend API.
#
# Leave it EMPTY for local development: the frontend then calls "/api/..."
# on its own origin and the Vite dev server proxies those calls to the
# PHP backend on http://localhost:8000 (see vite.config.ts).
#
# Set an absolute URL (e.g. http://localhost:8000) to call the backend
# directly. The backend must then allow this origin in its CORS_ORIGIN.
VITE_API_URL=

# OneSignal Web Push App ID (public passenger display board).
# The REST API key must NEVER be placed here - it belongs to the backend only.
VITE_ONESIGNAL_APP_ID=
